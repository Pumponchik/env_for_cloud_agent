  "key_empirical_findings": [
    {
      "claim": "LMD layouts score ~99% while rendered images score 76-86% — planner ok, renderer bottleneck",
      "source": "2305.13655"
    },
    {
      "claim": "SCoT ablation: Text CoT captures most reasoning gain; boxes capture most GenEval compositional gain — complementary not substitutable",
      "source": "2602.11980"
    },
    {
      "claim": "LI-DiT: naive LLM-as-encoder degrades prompt following due to NTP vs discriminative features + positional bias",
      "source": "2406.11831"
    },
    {
      "claim": "Structured Captions: shuffled same content loses vs ordered structure — structure itself is active ingredient",
      "source": "2507.05300"
    },
    {
      "claim": "ShortCoTI: CoT expansion can inject contradicting details; 54% shorter maintains quality",
      "source": "2510.05593"
    },
    {
      "claim": "ReGround: spatial grounding can dominate and suppress textual grounding in GLIGEN architecture",
      "source": "2403.13589"
    },
    {
      "claim": "GenEval 2: rewriting decreases human alignment on 4/6 models",
      "source": "2512.16853"
    },
    {
      "claim": "SEER: endogenous loop with only 300 proxy samples",
      "source": "2601.20305"
    },
    {
      "claim": "RAISE: mixed actions (rewrite/resample/edit) + checklist; 30-40% fewer samples, 80% fewer VLM calls",
      "source": "2603.00483"
    }
  ],
